# PostgreSQL (required)
DATABASE_URL="postgresql://booklane:booklane@127.0.0.1:5432/booklane"

# Signed session cookies (required). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public origin of this app — used in embed snippets and email links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. When unset, booking emails are logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Booklane <noreply@localhost>"
